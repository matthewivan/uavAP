{
	"data_handling": {
		"period": 200,
		"use_ipc": true,
		"use_idc": false,
		"ipc_sub": "comm_to_flight_analysis",
		"ipc_pub": "flight_analysis_to_comm"
	},
	"maneuver_planner": {
		"period": 20,
		"log_path": "/logs/",
		"print_maneuver_info": false,
		"maneuver_sets": {
			"roll_maneuver": {
				"maneuvers": [
					{
						"overrides": {
							"pid/roll": 0,
							"pid/climb_angle": 0
						},
						"transition": {
							"steady_state": {
								"duration": 2000,
								"sensor_values": {
									"attitude_x": 0.1,
									"attitude_y": 0.1,
									"air_speed": 1
								}
							}
						}
					},
					{
						"maintains": [
							"pid/pitch"
						],
						"waveforms": {
							"pid/roll": {
								"sine": {
									"amplitude": 30,
									"frequency": 0.25
								}
							}
						},
						"transition": {
							"duration": {
								"duration": 10000
							}
						}
					}
				],
				"save_as": "roll_maneuver.txt"
			},
			"get_trim": {
				"maneuvers": [
					{
						"overrides": {
							"pid/roll": 0.0,
							"pid/pitch": 0.0,
							"save_trim/pitch": 1.0,
							"save_trim/roll": 1.0,
							"save_trim/throttle": 1.0
						},
						"transition": {
							"steady_state": {
								"duration": 2000,
								"sensor_values": {
									"attitude_x": 0.1,
									"attitude_y": 0.1
								}
							}
						}
					}
				]
			},
